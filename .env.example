# Ces valeurs viennent de https://discord.com/developers/applications > ton application

# Token du bot. Utilisé par scripts/register_commands.py et par l'économie (connexion Gateway).
DISCORD_TOKEN=

# ID de l'application (visible sur la page "General Information")
DISCORD_APPLICATION_ID=

# Clé publique (visible sur la page "General Information"). Sert à vérifier que
# chaque requête reçue provient bien de Discord. Ce n'est PAS un secret, mais le
# serveur en a besoin pour démarrer.
DISCORD_PUBLIC_KEY=

# ID du serveur (guild) pour enregistrer les commandes en mode "dev" (instantané).
# Laisser vide pour un enregistrement global (peut prendre jusqu'à 1h à se propager).
GUILD_ID=

# Chemin du fichier SQLite. Sur Railway, pointer vers un volume monté pour
# que les données survivent aux redéploiements.
DATABASE_PATH=data/fiches.db

# --- Économie (base PocketBase du site des Chroniques du Temps) ---
# L'économie ne démarre que si DISCORD_TOKEN et PB_URL sont renseignés.
PB_URL=
# Compte superuser PocketBase dédié au bot.
PB_EMAIL=
PB_PASSWORD=
# Préfixe des commandes (?? comme sur Draftbot).
ECO_PREFIX=??
# Pendant les tests : ID du serveur Discord de test (le bot ignore alors les autres serveurs).
ECO_GUILD_ID=

# Combat des fiches de jeu (/attaque) : adresse du site et secret partagé avec lui (même valeur que CDT_SECRET_PARTAGE
# dans les variables du site). Sans eux, /attaque répond que le combat n'est pas branché.
# SITE_URL est facultatif : le site en ligne par défaut.
SITE_URL=
CDT_SECRET_PARTAGE=
