# Token du bot, à récupérer sur https://discord.com/developers/applications
DISCORD_TOKEN=

# ID du serveur (guild) pour synchroniser les commandes slash instantanément en dev.
# Laisser vide pour une synchronisation globale (peut prendre jusqu'à 1h à se propager).
GUILD_ID=

# Préfixe déclenchant la recherche d'une fiche, ex: "cdt-nomdelafiche"
LOOKUP_PREFIX=cdt-

# Chemin du fichier SQLite
DATABASE_PATH=data/fiches.db
